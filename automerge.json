{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest",
        "lockFileMaintenance",
        "minor",
        "patch",
        "pin",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "matchManagers": [ "github-actions" ],
      "automerge": true
    }
  ]
}
