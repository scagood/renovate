{
  "extends": [
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":ignoreModulesAndTests",
    ":ignoreUnstable",
    ":separateMultipleMajorReleases",
    ":pinDependencies",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "configMigration": true,
  "rangeStrategy": "update-lockfile",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "semanticCommitType": "deps",
    "semanticCommitScope": "lock"
  },
  "pinDigests": true,
  "prBodyTemplate": "{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "prBodyColumns": [ "Package", "Update", "Type", "Change" ],
  "postUpdateOptions": [
    "yarnDedupeFewer"
  ],
  "packageRules": [
    {
      "matchPackageNames": [ "*" ],
      "semanticCommits": "enabled",
      "semanticCommitType": "deps"
    },
    {
      "description": "Skip the release-age hold for my own packages/images",
      "matchPackageNames": [ "ghcr.io/scagood/**", "@scagood/**", "@darksheep/**" ],
      "minimumReleaseAge": "0"
    },
    {
      "matchDepTypes": [ "dependencies" ],
      "semanticCommitScope": "pkg"
    },
    {
      "matchDepTypes": [ "devDependencies" ],
      "semanticCommitScope": "dev"
    },
    {
      "matchDepTypes": [ "peerDependencies" ],
      "semanticCommitScope": "peer"
    },
    {
      "description": "Disable all expo automatice updates",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "gradle",
        "react",
        "react-*",
        "react-native",
        "react-native-*",
        "@react-native-async-storage/*",
        "@react-navigation/*",
        "@types/react",
        "@types/react-*"
      ],
      "enabled": false
    }
  ]
}
