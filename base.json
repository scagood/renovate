{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":disableRateLimiting",
    ":enableVulnerabilityAlerts",
    ":ignoreModulesAndTests",
    ":ignoreUnstable",
    ":separateMultipleMajorReleases",
    ":pinDependencies",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "configMigration": true,
  "rangeStrategy": "update-lockfile",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "semanticCommitType": "deps",
    "semanticCommitScope": "lock"
  },
  "pinDigests": true,
  "prBodyTemplate": "{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "prBodyColumns": [ "Package", "Update", "Type", "Change" ],
  "prBodyNotes": [
    ":no_bell: To stop Renovate pushing further updates to this PR, add the `stop-updating` label."
  ],
  "postUpdateOptions": [
    "yarnDedupeFewer"
  ],
  "packageRules": [
    {
      "matchPackageNames": [ "*" ],
      "semanticCommits": "enabled",
      "semanticCommitType": "deps"
    },
    {
      "description": "Skip the release-age hold for my own packages/images",
      "matchPackageNames": [ "ghcr.io/scagood/**", "@scagood/**", "@darksheep/**" ],
      "minimumReleaseAge": "0"
    },
    {
      "description": [
        "Renovate ages a digest update twice: at lookup by its tag's timestamp, which ECR Public, ghcr.io, lscr.io and GitHub Actions don't supply, and in the branch status check by a releaseTimestamp it never sets on digests. Under the default timestamp-required, a missing timestamp holds the update forever.",
        "Matched on update type alone so every file that pins the same image decides alike; exempting one manager split groups such as compose.yaml + workflow services (scagood/abb#507)."
      ],
      "matchUpdateTypes": [ "digest", "pinDigest" ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchDepTypes": [ "dependencies" ],
      "semanticCommitScope": "pkg"
    },
    {
      "matchDepTypes": [ "devDependencies" ],
      "semanticCommitScope": "dev"
    },
    {
      "matchDepTypes": [ "peerDependencies" ],
      "semanticCommitScope": "peer"
    },
    {
      "description": "Disable all expo automatice updates",
      "matchPackageNames": [
        "expo",
        "expo-*",
        "gradle",
        "react",
        "react-*",
        "react-native",
        "react-native-*",
        "@react-native-async-storage/*",
        "@react-navigation/*",
        "@types/react",
        "@types/react-*"
      ],
      "enabled": false
    }
  ]
}
